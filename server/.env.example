# ============================================================================
# MARKETOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `server/.env` for local development, or paste these keys
# into Vercel Dashboard -> Project -> Settings -> Environment Variables.
# ============================================================================

# 1. Server Port (Local Dev)
PORT=5000

# 2. Permanent Cloud PostgreSQL Database (Neon.tech or Supabase)
# Leave blank locally to use the built-in local database in `server/pgdata/`
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Session Security Secret (Any random 32+ character string)
JWT_SECRET=replace-with-a-long-random-secret-string-at-least-32-chars

# 4. Self-Serve Retailer Onboarding (true = instant approval on signup)
AUTO_APPROVE_USERS=true

# 5. Email OTP Notifications (Pick ONE: Resend, SendGrid, or Gmail/SMTP)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=MarketOS <notifications@yourdomain.com>

# Or Standard SMTP (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# 6. Google Sign-In (Optional)
# Register the exact production callback with Google.
GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# Comma-separated trusted frontend origins for cross-origin API calls.
# A same-origin deployment can leave this empty.
ALLOWED_ORIGIN=
